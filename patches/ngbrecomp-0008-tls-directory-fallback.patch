+static uint32_t g_tls_dir_fallback;
+
+/* Bytes of TLS block a directory asks for (template, zero fill, rounded, plus
+ * the slot-0 pointer), or 0 when it cannot be one: a template outside the
+ * image, or more than fits in the 0x200 bytes below the thread slot. */
+static uint32_t tls_block_size(const uint32_t *tls, uint32_t image_size)
+{
+    uint32_t start = tls[0], end = tls[1], zero_fill = tls[4];
+    uint32_t lo = XBOX_BASE_ADDRESS, hi = XBOX_BASE_ADDRESS + image_size;
+    uint32_t init, total;
+    if (end < start || (start && (start < lo || end > hi)) || zero_fill > 0x200)
+        return 0;
+    init = end - start;
+    if (init > 0x200)
+        return 0;
+    total = ((init + zero_fill + 0xF) & ~0xFu) + 4;
+    return total <= 0x200 ? total : 0;
+}
+
+void xbox_SetTlsDirectoryFallback(uint32_t va)
+{
+    g_tls_dir_fallback = va;
+}
