+/* The TLS directory to use when the XBE header's TlsAddress does not point at
+ * a sane one. Some dumps carry a rewritten header -- Animaniacs' US XBE was
+ * re-flagged as a debug image, and its TlsAddress lands in the header's own
+ * strings, whose "zero fill" size then walked a memset off the end of RAM --
+ * while the image itself is untouched, so the title knows where its
+ * _tls_used really is. Zero (the default) skips TLS setup for a bad header
+ * instead of trusting it. Set before xbox_MemoryLayoutInit(). */
+void xbox_SetTlsDirectoryFallback(uint32_t va);
+
 /* Carve a pure address-space reservation from the mapped range above RAM.
