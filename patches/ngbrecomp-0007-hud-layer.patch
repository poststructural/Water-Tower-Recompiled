+__attribute__((weak)) int nv2a_hud_rects(NV2AHudRect *rects, int max, int win_w, int win_h)
+{
+    (void)rects; (void)max; (void)win_w; (void)win_h;
+    return 0;
+}
+
+/* Copies the title's panels into frame f's buffer, clipped to the window;
+ * returns the copy regions. */
+static uint32_t hud_pack(unsigned f, VkBufferImageCopy *regions)
+{
+    NV2AHudRect rects[HUD_MAX_RECTS];
+    int ww = (int)s_extent.width, wh = (int)s_extent.height;
+    int n = nv2a_hud_rects(rects, HUD_MAX_RECTS, ww, wh);
+    uint32_t *dst = (uint32_t *)s_hud_ptr[f], used = 0, nr = 0;
+    bool swap = s_format == VK_FORMAT_R8G8B8A8_UNORM;
+    if (n > HUD_MAX_RECTS) n = HUD_MAX_RECTS;
+    for (int k = 0; k < n; k++) {
+        NV2AHudRect *r = &rects[k];
+        int x0 = r->x < 0 ? 0 : r->x, y0 = r->y < 0 ? 0 : r->y;
+        int x1 = r->x + r->w > ww ? ww : r->x + r->w;
+        int y1 = r->y + r->h > wh ? wh : r->y + r->h;
+        if (!r->argb || x1 <= x0 || y1 <= y0) continue;
+        uint32_t cw = (uint32_t)(x1 - x0), ch = (uint32_t)(y1 - y0);
+        if ((used + cw * ch) * 4u > HUD_BYTES) break;
+        for (uint32_t j = 0; j < ch; j++) {
+            const uint32_t *src = r->argb + (size_t)(y0 - r->y + (int)j) * r->w + (x0 - r->x);
+            uint32_t *d = dst + used + j * cw;
+            if (swap)
+                for (uint32_t i = 0; i < cw; i++) {
+                    uint32_t c = src[i];
+                    d[i] = (c & 0xFF00FF00u) | (c >> 16 & 0xFF) | (c & 0xFF) << 16;
+                }
+            else
+                memcpy(d, src, cw * 4u);
+        }
+        regions[nr++] = (VkBufferImageCopy){
+            .bufferOffset = (VkDeviceSize)used * 4u,
+            .bufferRowLength = cw,
+            .imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+            .imageOffset = { x0, y0, 0 },
+            .imageExtent = { cw, ch, 1 },
+        };
+        used += cw * ch;
+    }
+    return nr;
+}
